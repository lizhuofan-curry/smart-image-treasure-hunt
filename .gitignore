# ==================== Python 缓存 ====================

__pycache__/
*.py[cod]
*$py.class


# ==================== Python 虚拟环境 ====================

.env/
.venv/
venv/
env/


# ==================== IDE 配置 ====================

.idea/
.vscode/
*.iml


# ==================== 本地数据集 ====================

# 数据集压缩包
common/dataset/*.zip
common/dataset/*.rar
common/dataset/*.7z

# 数据集图片
common/dataset/*.jpg
common/dataset/*.jpeg
common/dataset/*.png
common/dataset/*.bmp

# 保留 Python 包文件和必要配置
!common/dataset/__init__.py
!common/dataset/.gitkeep
!common/dataset/fashion-labels.csv


# ==================== 模型与特征文件 ====================

*.pth
*.pt
*.ckpt
*.npy


# ==================== Web 运行时生成文件 ====================

web/static/uploads/*
web/static/results/*

# 保留空目录结构
!web/static/uploads/.gitkeep
!web/static/results/.gitkeep
!web/static/results/denoising/
web/static/results/denoising/*
!web/static/results/denoising/.gitkeep


# ==================== API 密钥 ====================

kimi.env
.env.local
*.env
*.env.*
!*.env.example
*.key


# ==================== 操作系统文件 ====================

.DS_Store
Thumbs.db
desktop.ini
